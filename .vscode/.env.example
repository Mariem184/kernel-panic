# Backend Server Configuration
PORT=3000

# Groq AI Model Configuration
# Sign up at https://console.groq.com/ to get your API key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Vector Database Configuration
# For local Qdrant Docker: http://localhost:6333 (API key can be left empty)
# For Qdrant Cloud: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kernel_panic_knowledge

# Optional: Embedding Settings (defaults to multilingual transformer Xenova/paraphrase-multilingual-MiniLM-L12-v2)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
